# Base de datos (debe apuntar al servicio "db" del docker-compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=infraops
DB_USER=infraops
DB_PASSWORD=infraops

# JWT
JWT_SECRET=changeme_usa_una_cadena_larga_y_aleatoria

# App
PORT=3000
# Cambiar a "production" en servidor (Docker). En desarrollo local usar "development".
NODE_ENV=development

# Herramientas de desarrollo/pruebas
# Habilita `npm run db:reset-month` (borra tareas de un mes). Setear "true"
# SOLO en el servidor de pruebas dedicado — nunca en producción real.
# ALLOW_TASK_RESET=true

# Integraciones
# 32 bytes hex (64 chars) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPT_KEY=your_64_char_hex_key_here

# InfraDoc (requerido — el backend crashea al arrancar si no están configurados)
INFRADOC_URL=http://<ip-o-dominio-de-infradoc>
INFRADOC_API_KEY=<api-key-de-infradoc>
